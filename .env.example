# ============================================================================
# LedgerMind — environment configuration template
# Version: v0.1 · 15-11-26 · Author: SHIVAM ITCS (JARVIS)
#
# LedgerMind reads plain environment variables at import time in
# backend/app/config.py — there is NO dotenv loader, so export these in your
# shell (or set them in systemd/Docker/Coolify) BEFORE the app is imported.
# `.env` is gitignored and never committed; this file is the committed
# reference of every knob. This project has no secrets: all values below are
# safe defaults / placeholders — never put real credentials here.
# ============================================================================

# SQLite database file (absolute or relative path). The parent directory is
# created automatically on boot. Default: backend/data/ledgermind.db
# Tests override this with a throwaway temp file (set before importing app).
LEDGERMIND_DB_PATH=backend/data/ledgermind.db

# Confidence gate (0..1) for the document pipeline: a document auto-posts a
# balanced journal entry only when validation passes AND its confidence score
# >= this threshold; otherwise it lands in the exception queue.
# Default: 0.80  (lower = more auto-posts; higher = safer)
LEDGERMIND_CONFIDENCE_THRESHOLD=0.80

# Bank-statement reconciliation match window, in days. Statement lines are
# matched to posted journal lines within +/- this many days of the posted
# date, by amount; memo similarity breaks ties. Default: 3
LEDGERMIND_RECON_WINDOW=3

# Actor stamped into the append-only audit_log when a request does not carry
# an X-User header. Default: system
LEDGERMIND_DEFAULT_USER=system

# --- Not env vars -----------------------------------------------------------
# Per-request actor override: send header `X-User: <name>` on any API call
# (read by app/routers/deps.py::get_audit).
# Server bind/port are uvicorn CLI flags: uvicorn app.main:app --host 0.0.0.0 --port 8000
# Effective runtime values are introspectable at GET /api/v1/system/config.
